# A FadeHost access token with the manage scope, so the app can run
# "whitelist add" on your server.
# Profile -> AI Access: https://laplace.fadehost.com/profile/ai-access
FADEHOST_TOKEN=

# The server to whitelist people on, e.g. server_abc123
SERVER_ID=

# The password for the admin page at /admin. Pick a long one.
ADMIN_PASSWORD=

# Optional: a Discord webhook that gets a message for every application
# and every decision.
DISCORD_WEBHOOK_URL=

# Optional: the heading on the form.
TITLE=Whitelist application

# The port to listen on. FadeHost sets this for you.
PORT=8080
